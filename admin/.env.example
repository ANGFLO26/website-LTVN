# Vite embeds these public, non-secret values when building the Admin bundle.
# Set this to the real public website before a production build.
# Missing/invalid production value disables website, product and article links.
# Development only: if omitted, the website defaults to http://localhost:5173/.
VITE_PUBLIC_SITE_URL=https://example.com

# Optional API origin or full API base (e.g. https://api.example.com/api).
# A bare origin gets /api appended. A base with a path preserves that path.
# Omit/leave blank to keep the existing same-origin /api reverse-proxy contract.
# API requests, login/session and Swagger all share this base.
VITE_API_BASE_URL=
