{
  "name": "lt-vietnam-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "npm --prefix admin run dev",
    "dev:api": "npm --prefix backend run start:dev",
    "build": "npm run check:i18n && tsc -b && vite build",
    "build:admin": "npm --prefix admin run build",
    "build:api": "npm --prefix backend run build",
    "start:api": "npm --prefix backend run start:prod",
    "db:generate": "npm --prefix backend run db:generate",
    "db:push": "npm --prefix backend run db:push",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:studio": "npm --prefix backend run db:studio",
    "db:seed": "npm --prefix backend run build && npm --prefix backend run db:seed",
    "db:backup": "node scripts/backup-db.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "check:i18n": "node scripts/validate-i18n.mjs",
    "lint": "oxlint src scripts vite.config.ts admin/src",
    "lint:api": "npm --prefix backend run lint",
    "test:api": "npm --prefix backend run test",
    "test:e2e": "npm --prefix backend run test:e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
