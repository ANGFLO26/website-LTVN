# ==========================================
# Server Configuration
# ==========================================
PORT=3000
# Bind address: 0.0.0.0 requires network access controls; same-host NGINX can use 127.0.0.1.
HOST=0.0.0.0
NODE_ENV=development

# Defaults to false: direct requests ignore X-Forwarded-For. Set loopback only for
# same-host NGINX, or a comma-separated list of trusted proxy IP/CIDR addresses.
# Do not use true or hop counts. NGINX must append/overwrite X-Forwarded-For.
TRUST_PROXY=false

# CORS allowed origins (comma-separated exact origins: scheme://host[:port])
# Required in production. Development defaults to local Vite dev/preview ports if unset.
# Example: https://www.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# Public website base URL for canonical sitemap and robots.txt generation
# Must be scheme://host[:port] without trailing slash, path, query, or hash.
# Required in production. Development defaults to http://localhost:5173 if unset.
# Example: https://www.example.com
PUBLIC_SITE_URL=

# Admin authentication (required; no default secret)
# Generate your own secret, e.g. node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Token lifetime in seconds, integer 1..86400
JWT_TTL_SECONDS=3600

# Admin account lockout policy (PR-04A: implementation defaults: 5 attempts, 15 minutes)
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Password Recovery & Admin Public URL (PR-10B: required in production)
ADMIN_PUBLIC_URL=http://localhost:5174
AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# ==========================================
# Distributed Rate Limiting (PR-04B)
# ==========================================
# Required in production: minimum 16-character secret for PII-safe HMAC-SHA256 IP hashing
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_HASH_SECRET=

# Rate Limit Thresholds (Defaults for corporate website)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

RATE_LIMIT_FORGOT_PASSWORD_MAX=3
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=900

RATE_LIMIT_RESET_PASSWORD_MAX=5
RATE_LIMIT_RESET_PASSWORD_WINDOW_SECONDS=900

RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_CONTACT_WINDOW_SECONDS=600

# ==========================================
# Cloudflare Turnstile Anti-Bot / CAPTCHA (PR-04B)
# ==========================================
# Secret key obtained from Cloudflare Turnstile dashboard (Required in production)
# For local dev/testing, dummy key: 1x0000000000000000000000000000000AA (always passes)
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=true
# Comma-separated allowed hostnames (e.g. ltvietnam.com.vn,admin.ltvietnam.com.vn)
TURNSTILE_ALLOWED_HOSTNAMES=

# ==========================================
# PostgreSQL Database Configuration (Drizzle ORM)
# ==========================================
# Connection URL format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=[mode]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ltvn_db

# ==========================================
# SMTP Email & Outbox Worker (PR-09B / PR-09C)
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ltvietnam.com.vn
CONTACT_NOTIFICATION_TO=contact@ltvietnam.com.vn

# Outbox Worker Configuration
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_SECONDS=10
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_PROCESSING_LEASE_SECONDS=300
OUTBOX_WORKER_ENABLED=true

# Application-level secret encryption (AES-256-GCM, 32-byte / 64-hex string)
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=
