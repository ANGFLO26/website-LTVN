diff --git "a/artifacts\\qa-2026-10-03\\qa16\\source-before\\admin.css" "b/admin\\src\\admin.css"
index d493059..760ed03 100644
--- "a/artifacts\\qa-2026-10-03\\qa16\\source-before\\admin.css"
+++ "b/admin\\src\\admin.css"
@@ -834,3 +834,93 @@ body {
     opacity: 1;
   }
 }
+
+/* Desktop keeps the existing 260px sidebar and page presentation. */
+.sidebar-toggle, .sidebar-close { display: none; }
+.sidebar-backdrop { position: fixed; inset: 0; z-index: 50; border: 0; background: rgba(0, 0, 0, 0.65); cursor: pointer; }
+.dashboard-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 24px; }
+.settings-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
+.page-actions { flex-wrap: wrap; }
+.card, .form-group, .form-row, .filter-bar, .page-title, .media-item { min-width: 0; }
+.form-control { min-width: 0; max-width: 100%; }
+.modal-dialog, .modal-body { min-width: 0; min-height: 0; }
+.modal-header, .modal-footer { flex-shrink: 0; }
+.modal-header h3 { min-width: 0; overflow-wrap: anywhere; }
+.modal-header .btn-icon { flex-shrink: 0; }
+.table-responsive { max-width: 100%; }
+.btn-icon:focus-visible, .menu-item:focus-visible, .sub-tab-btn:focus-visible, .tab-pill:focus-visible {
+  outline: 2px solid var(--primary); outline-offset: 2px;
+}
+
+@media (max-width: 1023px) {
+  .admin-main { margin-left: 0; width: 100%; }
+  .admin-sidebar { width: min(260px, calc(100% - 48px)); z-index: 60; visibility: hidden; transform: translateX(-100%); }
+  .admin-sidebar.is-open { visibility: visible; transform: translateX(0); }
+  .sidebar-toggle, .sidebar-close { display: inline-flex; }
+  .sidebar-brand { padding: 0 12px; gap: 8px; flex-shrink: 0; }
+  .brand-icon { flex-shrink: 0; }
+  .brand-info { min-width: 0; flex: 1; }
+  .sidebar-close { margin-left: auto; flex-shrink: 0; }
+  .sidebar-footer { flex-shrink: 0; }
+  .menu-item { min-height: 44px; }
+  .admin-header { height: auto; min-height: var(--header-height); padding: 12px 24px; flex-wrap: wrap; gap: 12px; }
+  .header-left { min-width: 0; flex: 1 1 280px; gap: 12px; }
+  .header-title { min-width: 0; overflow-wrap: anywhere; }
+  .header-right { min-width: 0; max-width: 100%; flex-wrap: wrap; gap: 8px; }
+  .admin-content { padding: 24px; min-width: 0; }
+  .dashboard-grid, .settings-grid { grid-template-columns: minmax(0, 1fr); }
+  .stat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .page-top > *, .card-header > * { max-width: 100%; }
+  .search-input { min-width: 0; max-width: 100%; width: 100%; }
+  .search-input input { min-width: 0; }
+  .filter-bar { width: 100%; }
+  .tab-pill-group { flex-wrap: wrap; max-width: 100%; }
+  .tab-pill { min-height: 44px; }
+  .table-responsive .data-table { min-width: 760px; }
+  .table-responsive { overscroll-behavior-x: contain; }
+  .data-table th { white-space: nowrap; }
+  .data-table td { overflow-wrap: anywhere; }
+  .translation-status-badge { white-space: nowrap; }
+  .btn { min-height: 44px; max-width: 100%; justify-content: center; }
+  .btn svg, .btn-icon svg { flex-shrink: 0; }
+  .btn-icon { min-width: 44px; min-height: 44px; }
+  .page-title, .card-title, .settings-grid code, .modal-body { overflow-wrap: anywhere; }
+  .modal-overlay { padding: 12px; }
+  .modal-dialog { max-height: calc(100vh - 24px); max-height: calc(100dvh - 24px); }
+  .modal-header, .modal-body, .modal-footer { padding: 16px; }
+  .modal-body { flex: 1 1 auto; }
+  .modal-footer { flex-wrap: wrap; }
+  .modal-footer .btn { flex: 1 1 auto; }
+  .form-row, .editor-grid, .contact-info-grid { grid-template-columns: minmax(0, 1fr) !important; }
+  .editor-fields { flex-direction: column; align-items: stretch !important; }
+  .editor-fields > .form-control { width: 100%; flex: none !important; }
+  .editor-fields > .btn-icon, .editor-grid > .btn-icon { justify-self: end; align-self: flex-end; }
+  .editor-section-header, .translation-header { flex-wrap: wrap; gap: 12px; }
+  .sub-tabs { min-width: 0; max-width: 100%; flex-shrink: 0; }
+  .sub-tab-btn { min-height: 44px; flex-shrink: 0; }
+  .toast-container { left: 12px; right: 12px; bottom: 12px; }
+  .toast { overflow-wrap: anywhere; }
+}
+
+@media (max-width: 600px) {
+  .admin-header { padding: 12px 16px; }
+  .header-left { flex-basis: 100%; }
+  .header-title { font-size: 1rem; }
+  .header-right { width: 100%; justify-content: space-between; gap: 6px; }
+  .header-right .btn { padding: 8px 10px; min-width: 44px; }
+  .header-secondary-label { display: none; }
+  .backend-indicator { width: 44px; height: 44px; justify-content: center; padding: 0; flex-shrink: 0; }
+  .backend-indicator > svg, .backend-indicator > span:last-child { display: none; }
+  .admin-content { padding: 20px 16px; }
+  .page-title h1 { font-size: 1.3rem; }
+  .stat-grid, .media-grid { grid-template-columns: minmax(0, 1fr); }
+  .stat-icon { flex-shrink: 0; }
+  .card-header { padding: 16px; }
+  .form-control { font-size: 16px; }
+  .contact-info-grid > div { min-width: 0; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .modal-dialog, .toast { animation: none; }
+  .btn, .btn-icon, .menu-item, .stat-card, .media-item { transition: none; }
+}
